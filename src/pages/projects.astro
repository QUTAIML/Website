---
import PhotoBreak from "@/components/PhotoBreak.astro";
import { loadImages } from "@/lib/content";
import "@/styles/projects.css";
import ExternalArrow from "@/components/ExternalArrow.astro";
import ContentLayout from "@/layouts/ContentLayout.astro";
import { loadProjectsData } from "@/scripts/projects/projects-loader";

const { pastProjects, types } = await loadProjectsData();

const projectCount = pastProjects.length;
const categoryCount = types.filter((type) => type !== "All").length;
const image = await loadImages();
---

<ContentLayout title="Projects | QUT AI & ML Society">
  <main class="projects-page">
    <section class="projects-hero">
      <svg class="project-network" id="project-network" aria-hidden="true"></svg>
      <div class="projects-shell projects-hero-layout">
        <div class="projects-hero-copy">
          <p class="projects-kicker">QUT AI & ML SOCIETY</p>
          <h1>Turn curiosity<br />into <span>proof.</span></h1>
          <p class="projects-intro">
            Explore the work AIML members have built across machine learning, data, vision, language, and intelligent systems.
          </p>
          <div class="project-hero-facts" aria-label="Project archive highlights">
            <span><strong>{projectCount}</strong> archived projects</span>
            <span><strong>{categoryCount}</strong> fields to explore</span>
          </div>
          <div class="projects-hero-actions">
            <a class="projects-hero-link" href="#project-archive">Explore the archive <span aria-hidden="true">↘</span></a>
            <a class="sandbox-text-link" href="/projects/sandbox">Try the ML Sandbox <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <figure class="projects-hero-image">
          <img src={image("projects/2025-sem-2/penguin-species.jpg")} alt="A visualisation from an AIML clustering project" />
          <figcaption>
            <span>FEATURED ARCHIVE</span>
            <strong>From first experiments to portfolio work.</strong>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="project-pathways" aria-labelledby="project-pathways-title">
      <div class="projects-shell project-pathways-layout">
        <div>
          <p class="projects-kicker">MAKE IT REAL</p>
          <h2 id="project-pathways-title">A place to start.<br /><span>A reason to keep going.</span></h2>
        </div>
        <p class="project-pathways-intro">Projects turn learning into something you can test, share, and continue building with people who care about the same questions.</p>
      </div>
      <div class="projects-shell project-pathway-cards">
        <article class="has-cover"><img class="card-cover" src={image("events/2026-sem-1/projects-night-1.jpg")} alt="" loading="lazy" />
          <span>01</span>
          <h3>Build together</h3>
          <p>Join practical work across real machine learning topics and grow through doing.</p>
        </article>
        <article class="has-cover"><img class="card-cover" src={image("images/hackathon-aiml-2026-5.jpg")} alt="" loading="lazy" />
          <span>02</span>
          <h3>Explore ideas</h3>
          <p>Try methods, datasets, and approaches that make AI concepts feel tangible.</p>
        </article>
        <article class="has-cover"><img class="card-cover" src={image("images/hackathon-aiml-2026-7.jpg")} alt="" loading="lazy" />
          <span>03</span>
          <h3>Show the work</h3>
          <p>Browse the archive for projects, code, and ideas worth taking further.</p>
        </article>
      </div>
    </section>

    <PhotoBreak src="events/2026-sem-1/projects-night-3.jpg" alt="A room of AIML members working at a project night" label="MADE BY MEMBERS" line="Curiosity becomes" accent="working code." />

    <section id="project-archive" class="projects-archive" aria-labelledby="project-archive-title">
      <div class="projects-shell projects-archive-heading">
        <div>
          <p class="projects-kicker">PROJECT ARCHIVE</p>
          <h2 id="project-archive-title">Work worth<br /><span>showing.</span></h2>
        </div>
        <p>Choose a topic, pick a project, and read through the notebook our members built.</p>
      </div>

      <div class="projects-shell">
        <div class="project-browser">
          <div class="project-browser-nav">
            <div class="project-filters" data-pagefind-ignore>
              <label class="project-browser-label" for="project-topic">TOPIC</label>
              <select class="project-filter-control project-topic-select" id="project-topic">
                {types.map((type) => (
                  <option value={type}>{type === "All" ? "All topics" : type} ({type === "All" ? projectCount : pastProjects.filter((project) => (project.type ?? project.category ?? "Other") === type).length})</option>
                ))}
              </select>
              <input class="project-filter-control" id="project-search" type="search" placeholder="Search projects" aria-label="Search projects by name or description" autocomplete="off" />
            </div>
            <p class="project-empty" id="project-empty" hidden data-pagefind-ignore>No projects match that search.</p>
            <ul class="project-list" id="project-list" aria-label="Projects">
              {pastProjects.map((project) => {
                const type = project.type ?? project.category ?? "Other";
                return (
                  <li data-type={type}>
                    <a class="project-row" href={project.github} target="_blank" rel="noopener noreferrer">
                      {project.image && <img class="project-row-thumb" src={project.image} alt="" loading="lazy" />}
                      <span class="project-row-text"><strong>{project.title}</strong><small>{type}</small></span>
                      <p hidden>{project.excerpt}</p>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
          <div class="project-viewer" id="project-viewer" data-pagefind-ignore>
            <div class="project-viewer-bar">
              <div><h3 id="project-viewer-title">Select a project</h3><p id="project-viewer-excerpt"></p></div>
              <div class="project-viewer-links">
                <a class="project-viewer-colab" id="project-viewer-colab" href="https://colab.research.google.com" target="_blank" rel="noopener noreferrer" hidden>Open in Colab <ExternalArrow /></a>
                <a class="project-viewer-link" id="project-viewer-link" href="https://github.com/QUTAIML" target="_blank" rel="noopener noreferrer">Open on GitHub <ExternalArrow /></a>
              </div>
            </div>
            <iframe class="project-viewer-frame" id="project-viewer-frame" title="Project notebook preview" sandbox="allow-popups allow-popups-to-escape-sandbox" srcdoc=""></iframe>
          </div>
        </div>
      </div>
    </section>

    <section class="sandbox-callout" aria-labelledby="sandbox-callout-title">
      <div class="projects-shell sandbox-callout-layout">
        <div>
          <p class="projects-kicker">INTERACTIVE DEMOS</p>
          <h2 id="sandbox-callout-title">Try machine learning<br /><span>in your browser.</span></h2>
        </div>
        <div>
          <p>Explore clustering, digit recognition, route planning, and decision boundaries in the ML Sandbox.</p>
          <a class="projects-hero-link" href="/projects/sandbox">Open the ML Sandbox <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <Fragment slot="scripts">
    <script>
      import "@/scripts/projects/projects-script.js";
      import "@/scripts/projects/project-network.js";
    </script>
  </Fragment>
</ContentLayout>
