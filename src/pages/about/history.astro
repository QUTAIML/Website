---
import "@/styles/about/history.css";
import ContentLayout from "@/layouts/ContentLayout.astro";

const rawTeamFiles = import.meta.glob("/public/data/about/*/team-details.json", { eager: true });
const photoFiles = import.meta.glob([
  "/public/data/about/*/team-photo.png",
  "/public/data/about/*/team-photo.jpg",
  "/public/data/about/*/team-photo.jpeg",
], { eager: true });

function groupMembersByRole(items) {
  return items.reduce((roles, member) => {
    if (!roles[member.role]) roles[member.role] = [];
    roles[member.role].push(member.name);
    return roles;
  }, {});
}

const teamsData = Object.entries(rawTeamFiles)
  .map(([path, file]) => {
    const folder = path.split("/").at(-2) ?? "";
    const year = Number.parseInt(folder, 10);
    const teamPhotoPath = Object.keys(photoFiles).find(photo => new RegExp(`/data/about/${year}/team-photo\\.(png|jpe?g)$`).test(photo));
    const executiveList = [...file.default]
      .sort((a, b) => a.title === "Academic Champions" ? 1 : b.title === "Academic Champions" ? -1 : 0)
      .map(team => ({ ...team, items: team.items.map(member => ({ ...member, image: member.image ? `/data/about/${year}/exec-photos/${member.image}` : null })) }));
    return { year, executiveList, people: executiveList.reduce((total, team) => total + team.items.length, 0), teamPhoto: teamPhotoPath?.replace(/^\/public/, "") ?? null };
  })
  .filter(entry => Number.isInteger(entry.year))
  .sort((a, b) => b.year - a.year);
---

<ContentLayout title="Our History | QUT AI & ML Society">
  <main class="history-page">
    <header class="history-hero" aria-labelledby="history-title"><div class="history-shell"><p class="history-kicker">QUT AI &amp; ML SOCIETY</p><h1 id="history-title">The people who<br /><span>shape AIML.</span></h1><p>A growing record of the executive teams who have turned curiosity into a community.</p><div class="history-hero-years" aria-label="Years on record" data-pagefind-ignore>{teamsData.map(entry => <a href={`#team-${entry.year}`}>{entry.year}</a>)}</div></div></header>

    <section class="history-timeline" aria-label="AIML team history"><div class="history-shell"><p class="history-intro">Every year adds a new chapter. The roster below is generated from AIML’s recorded team data, so future teams appear here as their data is added.</p><div class="history-entries">{teamsData.map((entry, index) => <article class:list={["history-entry", index === 0 && "history-entry-current"]} id={`team-${entry.year}`}><div class="history-year-rail"><span>{entry.year}</span><i aria-hidden="true"></i></div><div class="history-entry-content"><div class="history-entry-heading"><div><p class="history-kicker">{entry.year === 2025 ? "FOUNDING TEAM" : "TEAM YEAR"}</p><h2>{entry.year === 2025 ? "Where it began." : `Building in ${entry.year}.`}</h2></div><div class="history-count"><strong>{entry.people}</strong><span>people<br />recorded</span></div></div><div class="history-year-layout"><figure class="history-photo">{entry.teamPhoto ? <><img src={entry.teamPhoto} alt={`QUT AIML ${entry.year} team`} class="team-hero" data-modal={entry.year} /><figcaption>Tap to view full photo</figcaption></> : <div class="history-photo-empty">Team photo coming soon</div>}</figure><div class="history-portfolio-grid">{entry.executiveList.map(team => <section class="history-portfolio"><header><p>{team.title}</p><span>{team.items.length} {team.items.length === 1 ? "person" : "people"}</span></header><ul>{Object.entries(groupMembersByRole(team.items)).map(([role, names]) => <li><span>{role}</span><strong>{names.map(name => <span>{name}</span>)}</strong></li>)}</ul></section>)}</div></div></div></article>)}</div></div></section>
  </main>

  <Fragment slot="scripts"><script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll(".team-hero[data-modal]").forEach((image) => {
        image.addEventListener("click", () => {
          const dialog = document.createElement("dialog");
          dialog.className = "history-dialog";
          dialog.innerHTML = `<button type="button" aria-label="Close full-size team photo">×</button><img src="${image.src}" alt="${image.alt}" />`;
          document.body.appendChild(dialog);
          dialog.showModal();
          dialog.querySelector("button").addEventListener("click", () => dialog.close());
          dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
          dialog.addEventListener("close", () => dialog.remove());
        });
      });
    });
  </script></Fragment>
</ContentLayout>
