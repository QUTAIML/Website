---
import PhotoBreak from "@/components/PhotoBreak.astro";
import { loadImages } from "@/lib/content";
import "@/styles/events.css";
import ExternalArrow from "@/components/ExternalArrow.astro";
import ContentLayout from "@/layouts/ContentLayout.astro";
import { loadEventsData } from "@/scripts/events/events-loader";
import EventCard from "@/components/EventCard.astro";

const { eventsBySemester, types, featuredEvents } = await loadEventsData();
const eventCount = eventsBySemester.length;
const eventFormatCount = types.filter((type) => type !== "All").length;
const image = await loadImages();
---

<ContentLayout title="Events | QUT AI & ML Society">
  <div class="events-page">
    <header class="events-hero">
      <div class="events-shell events-hero-layout">
        <div class="events-hero-copy">
          <p class="events-kicker">QUT AI & ML SOCIETY</p>
          <h1>Where ideas<br /><span>take shape.</span></h1>
          <p class="events-hero-intro">
            Workshops, project nights, industry conversations, and social sessions for students ready to turn curiosity into practice.
          </p>
          <div class="event-hero-facts" aria-label="Event archive summary">
            <span><strong>{eventCount}</strong> event records</span>
            <span><strong>{eventFormatCount}</strong> ways to get involved</span>
          </div>
          <a class="events-hero-link" href="#event-archive">See what's on <span aria-hidden="true">↘</span></a>
        </div>

        <figure class="events-hero-image">
          <img src={image("events/2026-sem-1/projects-night-1.jpg")} alt="Students taking part in a QUT AIML event" />
          <figcaption>
            <span>QUT AIML IN ACTION</span>
            <strong>Learn together. Build together.</strong>
          </figcaption>
        </figure>
      </div>
    </header>

    <main>
    <section id="event-archive" class="events-archive" aria-label="What's on">
        <div class="events-shell">
          <section class="events-browser" aria-label="Browse events">
            <div class="events-controls" data-pagefind-ignore>
              <div class="event-filter-bar">
                <div class="search-wrapper">
                  <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <line x1="16.65" y1="16.65" x2="21" y2="21" />
                  </svg>
                  <input id="events-search" type="search" placeholder="Search events" aria-label="Search events" />
                </div>
                <select id="event-type-filter" class="event-filter-select" aria-label="Filter by event type">
                  {types.map((type) => <option value={type}>{type === "All" ? "All types" : `${type} (${eventsBySemester.filter((event) => (event.type ?? event.category ?? "Other") === type).length})`}</option>)}
                </select>
                <select id="event-when-filter" class="event-filter-select" aria-label="Show all, upcoming or past events" hidden>
                  <option value="all">All dates</option>
                  <option value="upcoming">Upcoming</option>
                  <option value="past">Past</option>
                </select>
                <div class="event-view-toggle" role="group" aria-label="Choose how to view events">
                  <button id="event-calendar-view" class="active" type="button" aria-pressed="true">Calendar</button>
                  <button id="event-list-view" type="button" aria-pressed="false">List</button>
                </div>
              </div>
            </div>

            <section class="events-panel">
              <ul id="events-list" class="events-list">
                {[...eventsBySemester].reverse().map((event) => (
                  <li class="event-row" data-semester={event.semesterId} data-type={event.type ?? event.category ?? "Event"} data-title={event.title.toLowerCase()} data-date={event.date} data-end-date={event.endDate} data-time={event.time} data-location={event.location}>
                    <time class="event-row-date" datetime={event.date}>{event.dateLabel}</time>
                    <span class="event-row-time">{event.time || (event.durationDays > 1 ? `${event.durationDays} days` : "")}</span>
                    <i class="event-row-dot" aria-hidden="true"></i>
                    {event.rubric
                      ? <a class="event-row-title" href={event.rubric} target="_blank" rel="noopener noreferrer">{event.title}</a>
                      : <span class="event-row-title">{event.title}</span>}
                    <span class="event-row-meta">{event.location}</span>
                    <p hidden>{event.excerpt}</p>
                  </li>
                ))}
              </ul>
              <div id="no-events-state" class="no-events-state" style="display: none;" data-pagefind-ignore>
                <p class="no-events-title">Nothing scheduled here yet</p>
                <p class="no-events-text">New workshops, talks, and project sessions will appear here when they are announced.</p>
                <a href="/contact">Stay connected <ExternalArrow /></a>
              </div>
            </section>

            <section id="events-calendar" class="events-calendar" aria-label="Event calendar" hidden data-pagefind-ignore>
              <div class="calendar-main">
                <div class="calendar-toolbar">
                  <div class="calendar-heading">
                    <h3 id="calendar-month-title"></h3>
                    <p id="calendar-position" class="calendar-position" hidden></p>
                    <div class="calendar-legend" aria-hidden="true">
                      <span class="is-upcoming">Coming up</span>
                      <span class="is-past">Past event</span>
                    </div>
                  </div>
                  <div class="calendar-actions">
                    <button id="calendar-today" class="calendar-today" type="button">Today</button>
                    <button id="calendar-previous" type="button" aria-label="Show previous month">‹</button>
                    <button id="calendar-next" type="button" aria-label="Show next month">›</button>
                  </div>
                </div>
                <div class="calendar-weekdays" aria-hidden="true">
                  <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
                </div>
                <div id="calendar-grid" class="calendar-grid"></div>
              </div>
              <aside id="calendar-details" class="calendar-details" aria-live="polite" aria-label="Details for the selected day"></aside>
            </section>

            <div id="events-pagination" data-pagefind-ignore></div>
          </section>
        </div>
      </section>

    <PhotoBreak src="events/2026-sem-1/bands-industry-night-2.jpeg" alt="A full room at the AIML and BANDS Industry Night" label="EVERY SEMESTER" line="Rooms full of" accent="curious people." />

    <section class="events-overview" aria-labelledby="events-overview-title">
        <div class="events-shell">
          <div class="events-overview-heading">
            <p class="events-kicker">MORE THAN A CALENDAR</p>
            <h2 id="events-overview-title">Make the work<br /><span>feel real.</span></h2>
            <p>Every event is a chance to meet people, test an idea, and take your next step in AI.</p>
          </div>
          <div class="event-pillars">
            <article class="has-cover"><img class="card-cover" src={image("events/2026-sem-1/projects-night-3.jpg")} alt="" loading="lazy" />
              <span>01</span>
              <h3>Build</h3>
              <p>Bring ideas to life at project nights, workshops, and practical sessions.</p>
            </article>
            <article class="has-cover"><img class="card-cover" src={image("events/2026-sem-1/bands-industry-night-5.jpeg")} alt="" loading="lazy" />
              <span>02</span>
              <h3>Meet</h3>
              <p>Hear from industry guests, alumni, and students working across the field.</p>
            </article>
            <article class="has-cover"><img class="card-cover" src={image("events/2026-sem-1/social-night-1.jpg")} alt="" loading="lazy" />
              <span>03</span>
              <h3>Challenge</h3>
              <p>Take on hackathons, competitions, and shared problems with your community.</p>
            </article>
          </div>
        </div>
      </section>

      {featuredEvents.length > 0 && (
        <section class="events-featured" aria-labelledby="featured-events-title">
          <div class="events-shell">
            <div class="section-split-heading">
              <div>
                <p class="events-kicker">COMING UP</p>
                <h2 id="featured-events-title">Make space<br /><span>for what is next.</span></h2>
              </div>
              <p>Save your place, bring a friend, and join the next AIML session.</p>
            </div>
            <div class="events-grid featured-events-grid">
              {featuredEvents.map((event) => <EventCard ev={event} href={`/events/${event.semesterId}/${event.slug}`} />)}
            </div>
          </div>
        </section>
      )}
    </main>
  </div>

  <Fragment slot="scripts">
    <script>
      import "@/scripts/events/events-script.js";
    </script>
  </Fragment>
</ContentLayout>
