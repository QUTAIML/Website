---
import "@/styles/events.css";
import ExternalArrow from "@/components/ExternalArrow.astro";
import ContentLayout from "@/layouts/ContentLayout.astro";
import { loadEventsData } from "@/scripts/events/events-loader";
import EventCard from "@/components/EventCard.astro";

const { semesters, eventsBySemester, types, featuredEvents } = loadEventsData();
const eventCount = eventsBySemester.length;
const eventFormatCount = types.filter((type) => type !== "All").length;
const today = new Date();
today.setHours(0, 0, 0, 0);
const hasUpcomingEvents = eventsBySemester.some((event) => new Date(event.date) >= today);
const defaultView = hasUpcomingEvents ? "upcoming" : "past";
const latestEventDate = [...eventsBySemester].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())[0]?.date ?? "";
---

<ContentLayout title="Events | QUT AI & ML Society">
  <div class="events-page" data-default-view={defaultView} data-calendar-start={latestEventDate}>
    <header class="events-hero">
      <div class="events-shell events-hero-layout">
        <div class="events-hero-copy">
          <p class="events-kicker">QUT AI & ML SOCIETY</p>
          <h1>Where ideas<br /><span>take shape.</span></h1>
          <p class="events-hero-intro">
            Workshops, project nights, industry conversations, and social sessions for students ready to turn curiosity into practice.
          </p>
          <div class="event-hero-facts" aria-label="Event archive summary">
            <span><strong>{eventCount}</strong> event records</span>
            <span><strong>{eventFormatCount}</strong> ways to get involved</span>
          </div>
          <a class="events-hero-link" href="#event-archive">Explore the archive <span aria-hidden="true">↘</span></a>
        </div>

        <figure class="events-hero-image">
          <img src="/data/events/sem-1-2026/images/projects-night-1.jpg" alt="Students taking part in a QUT AIML event" />
          <figcaption>
            <span>QUT AIML IN ACTION</span>
            <strong>Learn together. Build together.</strong>
          </figcaption>
        </figure>
      </div>
    </header>

    <main>
      <section class="events-overview" aria-labelledby="events-overview-title">
        <div class="events-shell">
          <div class="events-overview-heading">
            <p class="events-kicker">MORE THAN A CALENDAR</p>
            <h2 id="events-overview-title">Make the work<br /><span>feel real.</span></h2>
            <p>Every event is a chance to meet people, test an idea, and take your next step in AI.</p>
          </div>
          <div class="event-pillars">
            <article>
              <span>01</span>
              <h3>Build</h3>
              <p>Bring ideas to life at project nights, workshops, and practical sessions.</p>
            </article>
            <article>
              <span>02</span>
              <h3>Meet</h3>
              <p>Hear from industry guests, alumni, and students working across the field.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Challenge</h3>
              <p>Take on hackathons, competitions, and shared problems with your community.</p>
            </article>
          </div>
        </div>
      </section>

      {featuredEvents.length > 0 && (
        <section class="events-featured" aria-labelledby="featured-events-title">
          <div class="events-shell">
            <div class="section-split-heading">
              <div>
                <p class="events-kicker">COMING UP</p>
                <h2 id="featured-events-title">Make space<br /><span>for what is next.</span></h2>
              </div>
              <p>Save your place, bring a friend, and join the next AIML session.</p>
            </div>
            <div class="events-grid featured-events-grid">
              {featuredEvents.map((event) => <EventCard ev={event} href={`/events/${event.semesterId}/${event.slug}`} />)}
            </div>
          </div>
        </section>
      )}

      <section id="event-archive" class="events-archive" aria-labelledby="event-archive-title">
        <div class="events-shell">
          <div class="section-split-heading archive-heading">
            <div>
              <p class="events-kicker">EVENT ARCHIVE</p>
              <h2 id="event-archive-title">Find your next<br /><span>room to learn.</span></h2>
            </div>
            <p>
              {defaultView === "past"
                ? "Explore the sessions, speakers, projects, and moments that have shaped AIML so far."
                : "See what is coming up, then explore the sessions that have shaped AIML so far."}
            </p>
          </div>

          <section class="events-browser" aria-label="Browse events">
            <div class="events-controls" data-pagefind-ignore>
              <div class="controls-row">
                <div class="search-filter-wrapper">
                  <div class="search-wrapper">
                    <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="11" cy="11" r="7" />
                      <line x1="16.65" y1="16.65" x2="21" y2="21" />
                    </svg>
                    <input id="events-search" type="search" placeholder="Search the archive" aria-label="Search events" />
                  </div>

                  <span class="type-filter-label">Browse</span>
                  <div id="type-filters" class="type-filter-pill">
                    {types.map((type) => (
                      <button class={`type-btn ${type === "All" ? "active" : ""}`} data-type={type} type="button">
                        {type}
                      </button>
                    ))}
                  </div>

                  <div class="filters-wrapper">
                    <button id="filters-toggle" aria-label="More event filters" aria-haspopup="true" aria-expanded="false" type="button" class="filters-toggle-btn">
                      <svg class="filters-toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M3 4h18l-7 8v6l-4 2v-8L3 4z" />
                      </svg>
                      <span>Filters</span>
                    </button>
                    <div id="filters-popover" role="dialog" aria-modal="false" class="filters-popover">
                      <div class="filters-popover-content">
                        <div class="filter-group">
                          <label for="semester-select-pop">Semester</label>
                          <select id="semester-select-pop">
                            <option value="all" selected>All semesters</option>
                            {semesters.map((semester) => <option value={semester.id}>{semester.label}</option>)}
                          </select>
                        </div>
                        <div class="filter-group hidden-type">
                          <label for="type-select-pop">Type</label>
                          <select id="type-select-pop">
                            {types.map((type) => <option value={type}>{type}</option>)}
                          </select>
                        </div>
                        <div class="filter-group" id="sort-filter-group">
                          <label for="sort-select-pop">Show</label>
                          <select id="sort-select-pop">
                            <option value="upcoming" selected={defaultView === "upcoming"}>Upcoming events</option>
                            <option value="past" selected={defaultView === "past"}>Past events</option>
                          </select>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="event-view-toggle" role="group" aria-label="Choose event archive view">
                    <button id="event-archive-view" class="active" type="button" aria-pressed="true">Archive</button>
                    <button id="event-calendar-view" type="button" aria-pressed="false">Calendar</button>
                  </div>
                </div>
              </div>
            </div>

            <section class="events-panel">
              <section id="events-grid" class="events-grid">
                {eventsBySemester.map((event) => <EventCard ev={event} href={event.rubric || null} />)}
              </section>
              <div id="no-events-state" class="no-events-state" style="display: none;" data-pagefind-ignore>
                <p class="no-events-title">Nothing scheduled here yet</p>
                <p class="no-events-text">New workshops, talks, and project sessions will appear here when they are announced.</p>
                <a href="/contact">Stay connected <ExternalArrow /></a>
              </div>
            </section>

            <section id="events-calendar" class="events-calendar" aria-label="Event calendar" hidden data-pagefind-ignore>
              <div class="calendar-toolbar">
                <div>
                  <p class="calendar-kicker">EVENT CALENDAR</p>
                  <h3 id="calendar-month-title"></h3>
                </div>
                <div class="calendar-actions">
                  <button id="calendar-previous" type="button" aria-label="Show previous month">‹</button>
                  <button id="calendar-next" type="button" aria-label="Show next month">›</button>
                </div>
              </div>
              <div class="calendar-weekdays" aria-hidden="true">
                <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
              </div>
              <div id="calendar-grid" class="calendar-grid"></div>
              <p id="calendar-empty" class="calendar-empty" hidden>No matching events in this month. Try another month or adjust the archive filters.</p>
            </section>

            <div id="events-pagination" data-pagefind-ignore></div>
          </section>
        </div>
      </section>
    </main>
  </div>

  <Fragment slot="scripts">
    <script>
      import "@/scripts/events/events-script.js";
    </script>
  </Fragment>
</ContentLayout>
