---
import "@/styles/projects.css";
import ExternalArrow from "@/components/ExternalArrow.astro";
import ContentLayout from "@/layouts/ContentLayout.astro";
import SandboxSection from "@/components/sandbox/SandboxSection";
import {
  latestSemester,
  pastProjects,
  types,
} from "@/scripts/projects/projects-loader";

const projectCount = pastProjects.length;
const categoryCount = types.filter((type) => type !== "All").length;
const archiveLabel = latestSemester?.label ?? "Project archive";
---

<ContentLayout title="Projects | QUT AI & ML Society">
  <main class="projects-page">
    <section class="projects-hero">
      <div class="projects-shell projects-hero-layout">
        <div class="projects-hero-copy">
          <p class="projects-kicker">QUT AI & ML SOCIETY</p>
          <h1>Turn curiosity<br />into <span>proof.</span></h1>
          <p class="projects-intro">
            Explore the work AIML members have built across machine learning, data, vision, language, and intelligent systems.
          </p>
          <div class="project-hero-facts" aria-label="Project archive highlights">
            <span><strong>{projectCount}</strong> archived projects</span>
            <span><strong>{categoryCount}</strong> fields to explore</span>
          </div>
          <a class="projects-hero-link" href="#project-archive">Explore the archive <span aria-hidden="true">↘</span></a>
        </div>

        <figure class="projects-hero-image">
          <img src="/data/projects/sem-2-2025/images/penguin-species.jpg" alt="A visualisation from an AIML clustering project" />
          <figcaption>
            <span>FEATURED ARCHIVE</span>
            <strong>From first experiments to portfolio work.</strong>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Keep the live activities near the top of the page so they remain easy to discover.
         This is browser only because the demos create canvases and interactive state. -->
    <SandboxSection client:only="react">
      <section class="sandbox-loading" slot="fallback" aria-label="Loading ML Sandbox">
        <p>LEARN BY DOING</p>
        <h2>ML Sandbox</h2>
        <span>Loading the interactive activities</span>
      </section>
    </SandboxSection>

    <section class="project-pathways" aria-labelledby="project-pathways-title">
      <div class="projects-shell project-pathways-layout">
        <div>
          <p class="projects-kicker">MAKE IT REAL</p>
          <h2 id="project-pathways-title">A place to start.<br /><span>A reason to keep going.</span></h2>
        </div>
        <p class="project-pathways-intro">Projects turn learning into something you can test, share, and continue building with people who care about the same questions.</p>
      </div>
      <div class="projects-shell project-pathway-cards">
        <article>
          <span>01</span>
          <h3>Build together</h3>
          <p>Join practical work across real machine learning topics and grow through doing.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Explore ideas</h3>
          <p>Try methods, datasets, and approaches that make AI concepts feel tangible.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Show the work</h3>
          <p>Browse the archive for projects, code, and ideas worth taking further.</p>
        </article>
      </div>
    </section>

    <section id="project-archive" class="projects-archive" aria-labelledby="project-archive-title">
      <div class="projects-shell projects-archive-heading">
        <div>
          <p class="projects-kicker">{archiveLabel.toUpperCase()}</p>
          <h2 id="project-archive-title">Work worth<br /><span>showing.</span></h2>
        </div>
        <p>Search the archive by project type or title. Every card links to the project repository.</p>
      </div>

      <div class="projects-shell key-content">
        <div class="projects-controls">
          <div class="controls-row">
            <div class="mobile-search-filter">
              <div class="search-wrapper">
                <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" />
                  <line x1="16.65" y1="16.65" x2="21" y2="21" />
                </svg>
                <input id="projects-search" type="search" placeholder="Search the project archive" aria-label="Search projects" />
              </div>
            </div>

            <span class="type-filter-label">Browse:</span>
            <div class="type-scroll-wrapper">
              <button class="type-scroll-btn left" aria-label="Scroll project types left">‹</button>
              <div id="type-filters" class="type-filter-pill scrollable">
                {types.map((type) => (
                  <button class={`type-btn ${type === "All" ? "active" : ""}`} data-type={type} type="button">
                    {type}
                  </button>
                ))}
              </div>
              <button class="type-scroll-btn right" aria-label="Scroll project types right">›</button>
            </div>

            <button id="filters-toggle" aria-haspopup="true" aria-expanded="false" type="button" class="filters-toggle-btn">
              <svg class="filters-toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M3 4h18l-7 8v6l-4 2v-8L3 4z" />
              </svg>
              <span>Filters</span>
            </button>

            <div class="type-filter-wrapper" style="margin-left:auto; position:relative;">
              <div id="filters-popover" role="dialog" aria-modal="false" class="filters-popover">
                <div class="filters-popover-content">
                  <div class="filter-group filter-type">
                    <label for="type-select-pop">Type</label>
                    <select id="type-select-pop">
                      {types.map((type) => <option value={type}>{type}</option>)}
                    </select>
                  </div>
                  <div class="filter-group">
                    <label for="sort-select-pop">Sort data</label>
                    <select id="sort-select-pop">
                      <option value="" selected>None</option>
                      <option value="title-asc">Title ascending</option>
                      <option value="title-desc">Title descending</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <section class="projects-panel">
          <div class="desktop-type-filters">
            <div class="project-atlas-heading">
              <span>PROJECT ATLAS</span>
              <p>Explore the ideas our members have turned into working experiments.</p>
            </div>
            <section id="projects-grid" class="projects-grid" aria-label="Project archive">
              {pastProjects.map((project) => {
                const type = project.type ?? project.category ?? "Other";
                return (
                  <article class="project-card" data-semester={project.semesterId} data-category={project.category} data-type={type} data-title={project.title.toLowerCase()}>
                    <a href={project.github} target="_blank" rel="noopener noreferrer">
                      <div class="card-media">
                        {project.image ? <img src={project.image} alt={project.title} /> : <div class="no-image">No image available</div>}
                        <span class="project-category">{type}</span>
                      </div>
                      <div class="card-body">
                        <h3 class="card-title">{project.title}</h3>
                        <p class="card-description">{project.excerpt}</p>
                        <div class="card-footer">
                          <time class="card-date">{project.dateLabel}</time>
                          <span class="card-view-more">Open project <ExternalArrow /></span>
                        </div>
                      </div>
                    </a>
                  </article>
                );
              })}
            </section>
          </div>
        </section>
        <div id="projects-pagination"></div>
      </div>
    </section>
  </main>

  <Fragment slot="scripts">
    <script>
      import "@/scripts/projects/projects-script.js";
    </script>
  </Fragment>
</ContentLayout>
