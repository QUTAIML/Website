---
import { Icon } from "astro-icon/components";
---

<span class="external-arrow" aria-hidden="true"><Icon name="tabler:arrow-up-right" /></span>

<style>
  .external-arrow {
    align-items: center;
    display: inline-flex;
    line-height: 1;
    vertical-align: -0.08em;
  }

  .external-arrow :global(svg) {
    height: 1em;
    stroke-width: 2.4;
    width: 1em;
  }
</style>
