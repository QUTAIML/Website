---
import "@/styles/contact.css";
import ContentLayout from "@/layouts/ContentLayout.astro";

const socials = [
  {
    name: "Discord",
    label: "COMMUNITY CHAT",
    copy: "Ask a question, share an idea, and stay close to what AIML is building.",
    href: "https://discord.gg/CqkUzVVkXX",
    icon: "◉",
    action: "Join the conversation",
  },
  {
    name: "Instagram",
    label: "BEHIND THE SCENES",
    copy: "See event moments, announcements, and the people bringing the community together.",
    href: "https://www.instagram.com/qut_aiml",
    icon: "◎",
    action: "Follow AIML",
  },
  {
    name: "LinkedIn",
    label: "PROFESSIONAL NETWORK",
    copy: "Connect with AIML updates, industry activity, and opportunities beyond campus.",
    href: "https://www.linkedin.com/company/qutaiml",
    icon: "in",
    action: "Find us on LinkedIn",
  },
];
---

<ContentLayout title="Connect | QUT AI & ML Society">
  <main class="connect-page">
    <section class="connect-hero" aria-labelledby="connect-title">
      <div class="connect-shell connect-hero-layout">
        <div>
          <p class="connect-kicker">QUT AI & ML SOCIETY</p>
          <h1 id="connect-title">Find your<br /><span>people.</span></h1>
        </div>
        <div class="connect-hero-copy">
          <p>Questions, ideas, project updates, and new opportunities all start with a conversation.</p>
          <a href="https://discord.gg/CqkUzVVkXX" target="_blank" rel="noopener noreferrer">Join the Discord <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="connect-socials" aria-labelledby="socials-title">
      <div class="connect-shell">
        <div class="connect-section-heading">
          <div>
            <p class="connect-kicker">STAY IN THE LOOP</p>
            <h2 id="socials-title">Choose your<br /><span>way in.</span></h2>
          </div>
          <p>Each space offers a different way to take part in the QUT AI & ML community.</p>
        </div>

        <div class="connect-social-grid">
          {socials.map((social, index) => (
            <a href={social.href} target="_blank" rel="noopener noreferrer" class:list={["connect-social-card", { "connect-social-featured": index === 0 }]}>
              <span class="connect-social-icon" aria-hidden="true">{social.icon}</span>
              <div>
                <small>{social.label}</small>
                <h3>{social.name}</h3>
                <p>{social.copy}</p>
              </div>
              <strong>{social.action} <span aria-hidden="true">↗</span></strong>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="connect-direct" aria-labelledby="direct-title">
      <div class="connect-shell connect-direct-layout">
        <div class="connect-direct-title">
          <p class="connect-kicker">LET US KNOW</p>
          <h2 id="direct-title">Have something<br /><span>to share?</span></h2>
        </div>
        <div class="connect-direct-card">
          <p>For a question, collaboration idea, or partnership conversation, send a note to the AIML team.</p>
          <a href="mailto:qut-aiml@outlook.com">Email the team <span aria-hidden="true">↗</span></a>
          <small>We will reply as soon as we can.</small>
        </div>
      </div>
    </section>
  </main>
</ContentLayout>
