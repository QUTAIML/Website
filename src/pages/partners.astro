---
import { loadImages, partners } from "@/lib/content";
import "@/styles/partners.css";
import ExternalArrow from "@/components/ExternalArrow.astro";
import ContentLayout from "@/layouts/ContentLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
const image = await loadImages();
---

<ContentLayout description="QUT AI & ML Society partners and supporters">
  <div class="content-wrapper top-space partner-page">
    <section class="partner-hero" aria-labelledby="partner-title">
      <div class="partner-hero-copy">
        <p class="partner-eyebrow">BUILDING THE FUTURE TOGETHER</p>
        <h1 id="partner-title">Partners powering<br /><em>practical AI.</em></h1>
        <div class="partner-lede">
          <p>Our partners help turn curiosity into workshops, projects, industry insight, and meaningful opportunities for QUT students.</p>
          <a class="partner-cta" href="/contact">Partner with AIML <ExternalArrow /></a>
        </div>
      </div>
      <div class="partner-hero-art" aria-hidden="true" data-pagefind-ignore><i></i><i></i><i></i><i></i><b></b><span>COLLABORATION<br />IN MOTION</span></div>
    </section>

    <section class="partner-section" aria-labelledby="sponsor-title">
      <div class="partner-section-heading">
        <div><span>01 / SPONSOR</span><h2 id="sponsor-title">Strategic partner</h2></div>
        <p>Deep, long term collaboration supporting high impact initiatives for our community.</p>
      </div>
      {partners.filter(p => p.tier === "sponsor").map(p => (
        <a class="sponsor-spotlight" href={p.url} target="_blank" rel="noopener noreferrer">
          <div class="sponsor-mark"><img src={image(`images/${p.logo}`)} alt={p.name} /></div>
          <div class="sponsor-story"><span>{p.tag}</span><h3>{p.name}</h3><p>{p.description}</p><strong>{p.cta} <ExternalArrow /></strong></div>
        </a>
      ))}
    </section>

    <section class="partner-section" aria-labelledby="supporter-title">
      <div class="partner-section-heading">
        <div><span>02 / SUPPORTERS</span><h2 id="supporter-title">Community champions</h2></div>
        <p>Organisations opening doors to insight, professional connection, and resources for our members.</p>
      </div>
      <div class="supporter-showcase">
        {partners.filter(p => p.tier === "supporter").map((p, i) => (
          <a class="supporter-card supporter-brand" data-index={String(i + 1).padStart(2, "0")} href={p.url} target="_blank" rel="noopener noreferrer">
            <div class="supporter-logo"><img src={image(`images/${p.logo}`)} alt={p.name} /></div>
            <div><span>{p.tag}</span><h3>{p.name}</h3><p>{p.description}</p><strong>{p.cta} <ExternalArrow /></strong></div>
          </a>
        ))}
      </div>
      <section class="partner-impact" aria-labelledby="partner-impact-title">
        <header>
          <span>PARTNERSHIP IMPACT</span>
          <h3 id="partner-impact-title">Where support becomes <em>opportunity.</em></h3>
        </header>
        <div class="partner-impact-grid">
          <article><span>01</span><h4>Hands on workshops and events</h4><p>Practical spaces for members to learn, build, and share ideas.</p></article>
          <article><span>02</span><h4>Member insight and mentorship</h4><p>Conversations that make the industry feel closer and more accessible.</p></article>
          <article><span>03</span><h4>Industry pathways and connection</h4><p>Relationships that help students see what they can grow into.</p></article>
        </div>
      </section>
    </section>

    <section class="partner-events" aria-labelledby="partner-events-title">
      <div class="partner-events-heading">
        <div><span>03 / IN THE ROOM</span><h2 id="partner-events-title">Industry events<br /><em>we helped bring to life.</em></h2></div>
        <p>Partnership shows up in the rooms where students meet people, ideas, and opportunities beyond campus.</p>
      </div>
      <div class="partner-events-grid">
        <article class="partner-event-card partner-event-bands"><img src={image("events/2026-sem-1/bands-industry-night-1.jpeg")} alt="Attendees at the AIML x BANDS Industry Night" loading="lazy" /><div><span>AIML × BANDS</span><h3>Industry Night</h3></div></article>
        <article class="partner-event-card partner-event-agentcamp"><img src={image("events/2026-sem-1/agentcamp-1.jpeg")} alt="Attendees at AgentCamp" loading="lazy" /><div><span>COMMUNITY EVENT</span><h3>AgentCamp</h3></div></article>
        <article class="partner-event-card partner-event-devfest"><img src={image("events/2026-sem-1/google-devfest-1.jpeg")} alt="Attendees at Google DevFest" loading="lazy" /><div><span>COMMUNITY EVENT</span><h3>Google DevFest</h3></div></article>
      </div>
    </section>

    <section class="partner-callout">
      <p>New opportunities are always on the horizon.</p>
      <h2>Help shape what our members build next.</h2>
      <a href="/contact">Start a conversation <ExternalArrow /></a>
    </section>
  </div>
</ContentLayout>
