---
import { links, loadImages } from "@/lib/content";
import "@/styles/components/footer.css"
const image = await loadImages();

const groups = [
  { title: "Discover", items: [
    { label: "About", href: "/about" },
    { label: "Team", href: "/team" },
    { label: "Our history", href: "/about/history" },
    { label: "FAQ", href: "/about/faq" },
  ] },
  { title: "Take part", items: [
    { label: "Events", href: "/events" },
    { label: "Hackathon", href: "/hackathon" },
    { label: "Community", href: "/about/community" },
    { label: "Join the executive", href: "/about/exec-application" },
  ] },
  { title: "Build", items: [
    { label: "Projects", href: "/projects" },
    { label: "ML Sandbox", href: "/projects/sandbox" },
    { label: "Partners", href: "/partners" },
    { label: "Connect", href: "/contact" },
  ] },
  { title: "Stay close", items: [
    { label: "Discord", href: links.discord },
    { label: "Instagram", href: links.instagram },
    { label: "LinkedIn", href: links.linkedin },
    { label: "GitHub", href: links.github },
  ] },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-pitch">
      <img src={image("images/logo-full.svg")} alt="QUT AI & ML Society" class="footer-logo" />
      <a class="footer-cta" href={links.membership} target="_blank" rel="noopener noreferrer">Become a member <span aria-hidden="true">→</span></a>
    </div>

    <nav class="footer-links" aria-label="Footer">
      {groups.map((group) => (
        <div>
          <p>{group.title}</p>
          <ul>
            {group.items.map((item) => {
              const isExternal = item.href.startsWith("http");
              return <li><a href={item.href} {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{item.label}</a></li>;
            })}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="footer-base">
    <p>© {new Date().getFullYear()} QUT AI &amp; ML Society</p>
    <a href={links.codeOfConduct} target="_blank" rel="noopener noreferrer">Code of Conduct</a>
  </div>
</footer>
