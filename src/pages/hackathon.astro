---
import PhotoStrip from "@/components/PhotoStrip.astro";
import PhotoBreak from "@/components/PhotoBreak.astro";
import { loadImages, site } from "@/lib/content";
import "@/styles/hackathon.css";
import "@/styles/hackathon-folio.css";
import ContentLayout from "@/layouts/ContentLayout.astro";
const [aimlHackathon, brainsHackathon] = site.hackathons;
const image = await loadImages();
const aimlBuilds = ["CanvAssist", "Course2Career", "Clarity", "FuelFlow", "Neurovox", "Roadify"];
---

<ContentLayout title="Hackathon Recaps | QUT AI & ML Society">
  <div class="hackathon-page">
    <header class="hackathon-hero" aria-labelledby="hackathon-title">
      <canvas class="loss-landscape" id="loss-landscape" aria-hidden="true"></canvas>
      <div class="hackathon-shell"><p class="hackathon-kicker">QUT AI &amp; ML SOCIETY</p><h1 id="hackathon-title">Hackathons made<br /><span>to move ideas.</span></h1><p>This is where AIML celebrates its past hackathons. Our next hackathon is coming in Semester 1, 2027. Keep an eye on this page for more details.</p></div>
    </header>

    <!-- The countdown markup and script remain in src/scripts/hackathon for the next confirmed event. -->
    <PhotoStrip photos={[{ src: "images/hackathon-aiml-2026-1.jpeg", alt: "AIML Hackathon participants in the atrium" }, { src: "images/hackathon-brains-and-bots-1.jpeg", alt: "Brains and Bots participants" }, { src: "images/hackathon-aiml-2026-5.jpg", alt: "Team around a laptop" }, { src: "images/hackathon-brains-and-bots-3.jpeg", alt: "Prototype presentation" }, { src: "images/hackathon-aiml-2026-2.jpeg", alt: "Hackathon opening" }, { src: "images/hackathon-aiml-2026-4.jpg", alt: "Team with organisers" }, { src: "images/hackathon-brains-and-bots-2.jpeg", alt: "Hardware and software at work" }, { src: "images/hackathon-aiml-2026-6.jpg", alt: "Mentors reviewing a project" }]} />

    <!-- Each hackathon gets its own portfolio panel here; the full recap lives on its own page. -->
    <main class="hackathon-folios">
      <section class="hack-folio folio-aiml" id="aiml-hackathon-2026" aria-labelledby="folio-aiml-title">
        <span class="folio-aiml-year" aria-hidden="true">2026</span>
        <div class="hackathon-shell folio-layout">
          <div class="folio-copy">
            <p class="folio-index"><b>01</b> / 02 — HACKATHON RECAP</p>
            <h2 id="folio-aiml-title">The AIML<br /><span>Hackathon 2026.</span></h2>
            <p class="folio-lede">A build sprint for practical ideas. Teams turned everyday student and community challenges into working AI products in just a few days.</p>
            <div class="folio-stats"><div><strong>{aimlHackathon.participants}</strong><span>participants</span></div><div><strong>{aimlHackathon.teams}</strong><span>teams</span></div><p class="folio-badge"><b>QUT’s biggest</b> standalone student club hackathon to date</p></div>
            <ul class="folio-builds" aria-label="Some of the projects built">{aimlBuilds.map((name) => <li>{name}</li>)}</ul>
            <a class="folio-cta" href="/hackathon/aiml-2026">View full recap <span aria-hidden="true">→</span></a>
          </div>
          <div class="folio-collage">
            <figure style="--fan-x: 30%"><img src={image("images/hackathon-aiml-2026-1.jpeg")} alt="AIML Hackathon participants gathered in the QUT atrium" loading="lazy" /><figcaption>// kickoff</figcaption></figure>
            <figure style="--fan-x: -30%"><img src={image("images/hackathon-aiml-2026-5.jpg")} alt="AIML Hackathon team collaborating around a laptop" loading="lazy" /><figcaption>// build</figcaption></figure>
            <figure style="--fan-x: -20%"><img src={image("images/hackathon-aiml-2026-3.jpg")} alt="AIML Hackathon teams presenting projects at the exhibition" loading="lazy" /><figcaption>// demo day</figcaption></figure>
          </div>
        </div>
      </section>

      <section class="hack-folio folio-brains" id="brains-and-bots" aria-labelledby="folio-brains-title">
        <i class="folio-hazard" aria-hidden="true"></i>
        <div class="hackathon-shell folio-layout">
          <div class="folio-viewfinder">
            <img src={image("images/hackathon-brains-and-bots-2.jpeg")} alt="Brains and Bots team working on robotics hardware and software" loading="lazy" />
            <span class="vf-scan" aria-hidden="true"></span>
            <span class="vf-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span class="vf-tag" aria-hidden="true"><b></b>SEARCH ACTIVE</span>
            <span class="vf-coords" aria-hidden="true">27.477°S · 153.028°E</span>
            <span class="vf-radar" aria-hidden="true"></span>
          </div>
          <div class="folio-copy">
            <p class="folio-index"><b>02</b> / 02 — HACKATHON RECAP</p>
            <h2 id="folio-brains-title">Brains &amp; Bots<br /><span>Hackathon.</span></h2>
            <p class="folio-brief"><b>BRIEF</b> Disaster response</p>
            <p class="folio-lede">Three days, one challenge. Delivered with the QUT Robotics Club, teams paired AI with robotics hardware to help responders find people and act faster.</p>
            <dl class="folio-telemetry">
              <div><dt>PARTICIPANTS</dt><dd>{brainsHackathon.participants}</dd></div>
              <div><dt>TEAMS</dt><dd>{brainsHackathon.teams}</dd></div>
              <div><dt>DURATION</dt><dd>3 days</dd></div>
              <div><dt>PARTNER</dt><dd class="folio-telemetry-text">QUT Robotics Club</dd></div>
            </dl>
            <a class="folio-cta" href="/hackathon/brains-and-bots">View full recap <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <PhotoBreak src="images/hackathon-aiml-2026-3.jpg" alt="Teams presenting projects at the AIML Hackathon exhibition" label="DEMO DAY" line="Rough concepts," accent="real demos." />
    </main>
  </div>

  <script>import "@/scripts/hackathon/loss-landscape.js";</script>
  <script>import "@/scripts/hackathon/folio.js";</script>
</ContentLayout>
