---
import "@/styles/global.css";
import "@/styles/about/faq.css";
import Navigation from "@/components/Navigation.astro";
import Footer from "@/components/Footer.astro";

const questions = [
  { title: "What is the QUT AI & ML Society?", body: "The QUT AI & ML Society is a student led group at Queensland University of Technology focused on artificial intelligence and machine learning. The society supports learning through hands on workshops, collaborative projects, networking events, and talks with industry professionals. Members range from beginners curious about AI to students working on portfolios and real world machine learning applications." },
  { title: "Who can join?", body: "Any QUT student with an interest in AI, data science, machine learning, or related technology can join. The society welcomes students from all disciplines and skill levels who want to learn, build projects, and grow their technical skills." },
  { title: "What activities and events does the society run?", body: "The QUT AI & ML Society hosts a range of events including project nights, industry talks, networking nights, welcome events, and collaborative build sessions. These are designed to help members learn core tools and techniques in AI and machine learning and connect with peers and professionals in tech." },
  { title: "How can I volunteer or help with events?", body: "Members can volunteer by helping organise workshops, supporting project nights, mentoring peers, or assisting with social media and community outreach. The society often announces these opportunities through Discord and their social pages." },
  { title: "How do I become a sponsor or industry partner?", body: "Businesses and professionals interested in supporting the QUT AI & ML Society can reach out to the society’s team via their website or social media to discuss partnership opportunities. Sponsors often contribute through guest talks, mentorship, event support, and industry linked workshops." },
];
---

<html lang="en"><head><meta charset="utf-8" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><meta name="viewport" content="width=device-width" /><meta name="description" content="QUT AI & ML Society FAQ Page" /><title>FAQ | QUT AI & ML Society</title></head>
  <body class="background-dots"><Navigation />
    <main class="faq-page"><section class="faq-hero"><div class="faq-shell"><p>ANSWERS, WITHOUT THE HUNT</p><h1>Frequently asked<br /><span>questions.</span></h1><p>Everything you need to know about getting involved with the QUT AI &amp; ML Society.</p></div></section>
      <section class="faq-join"><div class="faq-shell"><div><p>MEMBERSHIP</p><h2>Ready to<br /><span>join in?</span></h2></div><div><p>If you’re a QUT student interested in AI, machine learning, or data science, becoming a member is easy. Joining gives you access to events, workshops, project nights, and networking opportunities with industry professionals and fellow students.</p><a href="https://campus.hellorubric.com/?tab=memberships&s=11397" target="_blank" rel="noopener noreferrer">Become a member <b aria-hidden="true">↗</b></a></div></div></section>
      <section class="faq-list"><div class="faq-shell"><p class="faq-list-kicker">THE BASICS</p><div>{questions.map((question, index) => <article><span>{String(index + 1).padStart(2, "0")}</span><div><h2>{question.title}</h2><p>{question.body}</p></div><b aria-hidden="true">↗</b></article>)}</div></div></section>
      <section class="faq-footer"><div class="faq-shell"><p>STILL HAVE A QUESTION?</p><div><a href="https://discord.gg/CqkUzVVkXX" target="_blank" rel="noopener noreferrer">Discord ↗</a><a href="https://github.com/qut-aiml" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://www.instagram.com/qut_aiml/" target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href="https://www.linkedin.com/company/qut-aiml/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div></section>
    </main><Footer />
  </body>
</html>
